# Скопируйте в .env и впишите свои значения. Файл .env никому не пересылайте и не выкладывайте.
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключи приложения с dev.twitch.tv/console (OAuth Redirect URL в приложении: http://localhost)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Код привязки: отправьте боту «/start код», чтобы бот слушался только вас
BOT_PAIR_CODE=
# Обычно менять не нужно
TWITCH_REDIRECT_URI=http://localhost
